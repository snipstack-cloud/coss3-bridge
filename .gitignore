# СЕКРЕТЫ. nim_key.txt содержит рабочий ключ OpenRouter. В git он не попадает
# НИКОГДА: из истории репозитория ключ не удаляется обычным rm — он остаётся в
# коммитах, и любой, кто склонирует, его получит. Ключ передаётся переменной
# окружения (NVIDIA_API_KEY) или лежит локально нетронутым.
nim_key.txt
.coss3_nim_key
docker/coss3.env

# Данные прогонов: их место в /io на сервере и в трассах, а не в истории кода.
# Иначе репозиторий распухнет, а diff станет нечитаемым.
*.log
*.jsonl
coss3_llm.*.log
docker/io/
replay_lessons.txt

# Мусор
__pycache__/
*.pyc
.DS_Store
*.bak-*

# Deploy key сервера опытов. Лежит он вне репозитория (~/.ssh/coss3_deploy),
# но правило здесь на случай, если кто-то положит копию рядом: приватный ключ
# ни в git, ни в образ не попадает никогда. Из истории git его обычным rm не
# удалить, а слой образа с ключом достанет любой, у кого есть образ.
*deploy_key*
coss3_deploy*
id_ed25519*
*.pem

# Хвосты живых прогонов на Windows: 21.09 пустой run.err уехал в коммит
# вместе с git add -A. Трассы и логи партии в репозитории не место.
run.log
run.err
run_*.log
run_*.err
