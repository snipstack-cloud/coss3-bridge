# Общие настройки всех копий. Скопировать в coss3.env и вписать своё.
# Файл с ключом в git НЕ класть.

# Маршрутизация через пресет: 8 из 8 вызовов через DeepSeek за 1,8-2,5 с при
# бюджете такта 14 с. Без него провайдеры гуляют и дают до 37,7 с.
COSS3_MODEL=@preset/coss3-bot
NIM_BASE_URL=https://openrouter.ai/api/v1
NVIDIA_API_KEY=

COSS3_EVERY=20
COSS3_WAVE_MIN=20

# dxvk (D3D9 -> Vulkan) или wined3d (D3D9 -> OpenGL). DXVK на этой игре уже
# поднимался, wined3d — запасной путь.
COSS3_D3D=dxvk

# Разрешение. Меньше — меньше работы растеризатору; на десяти копиях это
# заметно, особенно без видеокарты.
COSS3_RES=800x600

# 1 включает VNC на порту 5900 контейнера. Нужен на первом запуске: бой
# заводится руками, дальше партии идут сами.
COSS3_VNC=0
