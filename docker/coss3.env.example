# Общие настройки всех копий. Скопировать в coss3.env и вписать своё.
# Файл с ключом в git НЕ класть.

# Маршрутизация через пресет: 8 из 8 вызовов через DeepSeek за 1,8-2,5 с при
# бюджете такта 14 с. Без него провайдеры гуляют и дают до 37,7 с.
COSS3_MODEL=@preset/coss3-bot
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_API_KEY=
# Старые имена тоже понимаются: NIM_BASE_URL, NVIDIA_API_KEY.

COSS3_EVERY=20
COSS3_WAVE_MIN=20

# dxvk (D3D9 -> Vulkan) или wined3d (D3D9 -> OpenGL). DXVK на этой игре уже
# поднимался, wined3d — запасной путь.
COSS3_D3D=dxvk

# Разрешение. Меньше — меньше работы растеризатору; на десяти копиях это
# заметно, особенно без видеокарты.
COSS3_RES=800x600

# 1 включает VNC на порту 5900 контейнера. Нужен на первом запуске: бой
# заводится руками, дальше партии идут сами.
COSS3_VNC=0

# --- ИДЕЯ ОПЫТА ---
# Имя секции из docker/experiments.ini КЛОНА. Флаги и описание берутся оттуда,
# то есть идея версионирована: по SHA моста видно, с чем он играл. Нет такой
# секции — контейнер не стартует, а не играет «без флагов» под её именем.
# COSS3_EXPERIMENT=wave40
#
# Перебить флаги вручную (тогда в лог печатается, что файл перебит):
# COSS3_EXTRA_FLAGS=--wave-min 40

# --- РЕЗУЛЬТАТ ОБРАТНО В GIT ---
# Куда отправлять итог прогона: отчёт, трассу, квитанцию условий, SHA моста и
# хвосты логов. Без этого прогон умирает вместе с контейнером.
#
# НУЖЕН ОТДЕЛЬНЫЙ КЛЮЧ С ПРАВОМ ЗАПИСИ — тот, что монтируется для чтения моста,
# только на чтение. Заводится на GitHub как второй deploy key с галкой
# «Allow write access» и монтируется в /ssh/results_key.
#
# ОТДЕЛЬНЫЙ РЕПОЗИТОРИЙ ЛУЧШЕ ТОГО ЖЕ. Ключ с правом записи живёт внутри
# контейнера; если он утечёт, в отдельном репозитории потеряются результаты, а
# в общем — сам мост.
# COSS3_RESULTS_GIT=git@github.com:snipstack-cloud/coss3-results.git
# COSS3_RESULTS_BRANCH=results
# COSS3_RESULTS_KEY=/ssh/results_key
# COSS3_RESULTS_NAME=wave40/0     # по умолчанию <идея>/<номер копии>

# --- КОНЕЦ ПАРТИИ ---
# Сколько партий сыграть подряд. После каждой мост сам шлёт NEW; это работает и
# с экрана поражения, где симуляция стоит на паузе, — команду там берёт блок
# конца партии в интерфейсе.
COSS3_EPISODES=1

# 1 — держать контейнер живым после того, как политика вышла. Иначе логи боя
# не прочитать: `docker exec` на остановленном контейнере отвечает
# «container is not running». Разбор кладётся в /io/report.txt в любом случае.
COSS3_KEEP_ALIVE=1

# --- УСЛОВИЯ ПАРТИИ ---
# Без них DoNewGame берёт то, что осталось в меню, и у десяти копий условия
# окажутся разными — сравнивать идеи станет нельзя. Значения из кода игры:
#   MATCH_RES    0 -> 1000 ресурсов, 1 -> 4000, 2 -> 5000 (initmapgen.inc:167)
#   MATCH_PEACE  0 -> БЕЗ времени мира (_misc_GetPeaceTime, misc.script:4264)
#   MATCH_AI     0 Normal, 1 Hard, 2 Very Hard, 3 IMPOSSIBLE. Осторожно: в
#                списке интерфейса уровни с 1, а в поле пишется на единицу
#                меньше (showcustomgame.inc:647), поэтому «Невозможный» = 3
#   MATCH_NATION строковый sid: net Нидерланды, ukr Украина, rus Россия,
#                eng Англия, fra Франция (country.script:45)
# Имена с MATCH_ нарочно: COSS3_RES занято разрешением ЭКРАНА.
COSS3_MATCH_RES=0
COSS3_MATCH_PEACE=0
COSS3_MATCH_AI=3
COSS3_MATCH_NATION=net

# --- МОСТ ИЗ GIT ---
# Без этого контейнер берёт мост, запечённый в образ: для проверки образа
# годится, для опытов нет — версия ничем не подтверждена.
# COSS3_BRIDGE_GIT=git@github.com:snipstack-cloud/coss3-bridge.git
# COSS3_BRIDGE_REF=master
